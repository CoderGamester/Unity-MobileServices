.sample-root { background-color: rgb(26, 15, 39); color: rgb(253, 246, 255); font-size: 16px; }
.sample-scroll { padding-left: 12px; padding-right: 12px; padding-top: 12px; padding-bottom: 24px; }
.sample-hero { flex-shrink: 0; background-color: rgb(64, 32, 78); border-left-width: 4px; border-left-color: rgb(241, 159, 255); padding: 16px 18px; margin-bottom: 12px; }
.sample-title { font-size: 34px; -unity-font-style: bold; color: rgb(253, 246, 255); margin-bottom: 6px; }
.sample-subtitle { font-size: 17px; color: rgb(232, 204, 240); white-space: normal; }
.sample-eyebrow { font-size: 13px; -unity-font-style: bold; color: rgb(241, 159, 255); margin-bottom: 5px; }
.sample-status-card { flex-shrink: 0; background-color: rgb(47, 24, 59); border-left-width: 2px; border-left-color: rgb(184, 107, 202); padding: 12px 14px; margin-bottom: 12px; }
.sample-status { color: rgb(240, 227, 244); font-size: 15px; white-space: normal; margin-bottom: 5px; }
.sample-card { flex-shrink: 0; background-color: rgb(46, 24, 57); border-top-width: 1px; border-top-color: rgb(108, 59, 126); border-bottom-width: 1px; border-bottom-color: rgb(108, 59, 126); border-left-width: 1px; border-left-color: rgb(108, 59, 126); border-right-width: 1px; border-right-color: rgb(108, 59, 126); padding: 14px 16px; margin-bottom: 12px; }
.sample-section { font-size: 21px; -unity-font-style: bold; color: rgb(247, 186, 255); margin-bottom: 4px; }
.sample-card-description { color: rgb(226, 205, 232); font-size: 15px; white-space: normal; margin-bottom: 12px; }
.preset-row { flex-shrink: 0; flex-direction: row; flex-wrap: nowrap; align-items: center; background-color: rgb(57, 30, 70); padding: 8px 10px; margin-bottom: 7px; }
.preset-row > Label { min-width: 0; flex-basis: 0; flex-grow: 1; flex-shrink: 1; color: rgb(253, 246, 255); font-size: 14px; -unity-font-style: bold; white-space: normal; margin-right: 6px; }
.preset-row .sample-button { min-width: 0; flex-basis: 0; flex-grow: 1; padding-left: 5px; padding-right: 5px; font-size: 14px; white-space: normal; }
.sample-action-grid { flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: stretch; margin-top: 10px; }
.sample-button { flex-shrink: 0; min-width: 148px; min-height: 44px; flex-grow: 1; background-color: rgb(76, 42, 92); border-top-width: 1px; border-top-color: rgb(241, 159, 255); border-bottom-width: 1px; border-bottom-color: rgb(241, 159, 255); border-left-width: 1px; border-left-color: rgb(241, 159, 255); border-right-width: 1px; border-right-color: rgb(241, 159, 255); color: rgb(253, 246, 255); font-size: 16px; -unity-font-style: bold; margin-right: 8px; margin-bottom: 8px; padding-left: 12px; padding-right: 12px; }
.sample-control-group { flex-shrink: 0; background-color: rgb(57, 30, 70); padding: 9px 10px; margin-bottom: 8px; }
.sample-control-label { color: rgb(247, 186, 255); font-size: 16px; -unity-font-style: bold; margin-bottom: 4px; }
.sample-slider { flex-shrink: 0; min-width: 230px; }
.sample-primary-action { flex-shrink: 0; min-width: 148px; min-height: 48px; flex-grow: 1; background-color: rgb(241, 159, 255); color: rgb(47, 17, 58); font-size: 17px; -unity-font-style: bold; margin-right: 8px; margin-bottom: 8px; }
.sample-log { flex-shrink: 0; background-color: rgb(33, 17, 41); border-left-width: 3px; border-left-color: rgb(241, 159, 255); color: rgb(247, 238, 250); font-size: 15px; white-space: normal; padding: 12px; min-height: 82px; }
.sample-button, .sample-primary-action { transition-property: background-color, border-color, scale, translate, opacity; transition-duration: 120ms; transition-timing-function: ease-out; }
.sample-button:hover { background-color: rgb(98, 54, 117); }
.sample-button:active { background-color: rgb(55, 29, 68); scale: 0.98; translate: 0 1px; }
.sample-button:focus { border-color: rgb(253, 246, 255); }
.sample-button:disabled { opacity: 0.45; scale: 1; translate: 0 0; }
.sample-button--pressed { background-color: rgb(55, 29, 68); scale: 0.96; translate: 0 2px; opacity: 0.92; }
.sample-primary-action.sample-button--pressed { background-color: rgb(209, 126, 224); }
.sample-primary-action:hover { background-color: rgb(248, 190, 255); }
.sample-primary-action:active { background-color: rgb(209, 126, 224); scale: 0.98; translate: 0 1px; }
.sample-primary-action:focus { border-color: rgb(253, 246, 255); }
.sample-primary-action:disabled { opacity: 0.45; scale: 1; translate: 0 0; }
