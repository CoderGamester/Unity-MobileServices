.sample-root { background-color: rgb(13, 31, 22); color: rgb(240, 252, 243); font-size: 16px; }
.sample-scroll { padding-left: 12px; padding-right: 12px; padding-top: 12px; padding-bottom: 24px; }
.sample-hero { flex-shrink: 0; background-color: rgb(24, 65, 43); border-left-width: 4px; border-left-color: rgb(94, 235, 160); padding: 16px 18px; margin-bottom: 12px; }
.sample-title { font-size: 34px; -unity-font-style: bold; color: rgb(240, 252, 243); margin-bottom: 6px; }
.sample-subtitle { font-size: 17px; color: rgb(199, 238, 208); white-space: normal; }
.sample-eyebrow { font-size: 13px; -unity-font-style: bold; color: rgb(94, 235, 160); margin-bottom: 5px; }
.sample-status-card { flex-shrink: 0; background-color: rgb(19, 53, 34); border-left-width: 2px; border-left-color: rgb(69, 173, 116); padding: 12px 14px; margin-bottom: 12px; }
.sample-status { color: rgb(220, 247, 225); font-size: 15px; white-space: normal; margin-bottom: 7px; }
.sample-card { flex-shrink: 0; background-color: rgb(18, 48, 31); border-top-width: 1px; border-top-color: rgb(49, 110, 76); border-bottom-width: 1px; border-bottom-color: rgb(49, 110, 76); border-left-width: 1px; border-left-color: rgb(49, 110, 76); border-right-width: 1px; border-right-color: rgb(49, 110, 76); padding: 14px 16px; margin-bottom: 12px; }
.sample-section { font-size: 21px; -unity-font-style: bold; color: rgb(137, 247, 181); margin-bottom: 4px; }
.sample-card-description { color: rgb(201, 231, 208); font-size: 15px; white-space: normal; margin-bottom: 12px; }
.sample-action-grid { flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: stretch; margin-top: 8px; }
.sample-action-grid .sample-button, .sample-action-grid .sample-primary-action { min-width: 0; flex-basis: 0; white-space: normal; padding-left: 8px; padding-right: 8px; }
.notification-action-grid { flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: stretch; margin-top: 8px; }
.notification-action-grid .sample-button, .notification-action-grid .sample-primary-action { min-width: 150px; flex-basis: 150px; flex-grow: 1; white-space: normal; font-size: 15px; min-height: 48px; padding-left: 10px; padding-right: 10px; }
.sample-button { flex-shrink: 0; min-width: 148px; min-height: 44px; flex-grow: 1; background-color: rgb(29, 77, 48); border-top-width: 1px; border-top-color: rgb(94, 235, 160); border-bottom-width: 1px; border-bottom-color: rgb(94, 235, 160); border-left-width: 1px; border-left-color: rgb(94, 235, 160); border-right-width: 1px; border-right-color: rgb(94, 235, 160); color: rgb(240, 252, 243); font-size: 16px; -unity-font-style: bold; margin-right: 8px; margin-bottom: 8px; padding-left: 12px; padding-right: 12px; }
.sample-primary-action { flex-shrink: 0; min-width: 148px; min-height: 48px; flex-grow: 1; background-color: rgb(94, 235, 160); color: rgb(9, 42, 22); font-size: 17px; -unity-font-style: bold; margin-right: 8px; margin-bottom: 8px; }
.sample-field-row { flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: center; background-color: rgb(26, 69, 43); padding: 9px 10px; margin-bottom: 8px; }
.sample-control-label { min-width: 132px; color: rgb(190, 245, 207); font-size: 16px; -unity-font-style: bold; margin-right: 8px; }
.sample-field { flex-shrink: 0; min-width: 190px; flex-grow: 1; }
.pending-row { flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: center; background-color: rgb(25, 65, 40); border-left-width: 2px; border-left-color: rgb(94, 235, 160); padding: 9px 10px; margin-bottom: 7px; }
.pending-row > Label { flex-grow: 1; color: rgb(229, 249, 234); font-size: 15px; white-space: normal; }
.sample-log { flex-shrink: 0; background-color: rgb(10, 29, 18); border-left-width: 3px; border-left-color: rgb(94, 235, 160); color: rgb(229, 249, 234); font-size: 15px; white-space: normal; padding: 12px; min-height: 90px; }
.sample-button, .sample-primary-action { transition-property: background-color, border-color, scale, translate, opacity; transition-duration: 120ms; transition-timing-function: ease-out; }
.sample-button:hover { background-color: rgb(40, 101, 64); }
.sample-button:active { background-color: rgb(20, 57, 35); scale: 0.98; translate: 0 1px; }
.sample-button:focus { border-color: rgb(240, 252, 243); }
.sample-button:disabled { opacity: 0.45; scale: 1; translate: 0 0; }
.sample-button--pressed { background-color: rgb(20, 57, 35); scale: 0.96; translate: 0 2px; opacity: 0.92; }
.sample-primary-action.sample-button--pressed { background-color: rgb(66, 194, 126); }
.sample-primary-action:hover { background-color: rgb(128, 248, 185); }
.sample-primary-action:active { background-color: rgb(66, 194, 126); scale: 0.98; translate: 0 1px; }
.sample-primary-action:focus { border-color: rgb(240, 252, 243); }
.sample-primary-action:disabled { opacity: 0.45; scale: 1; translate: 0 0; }
